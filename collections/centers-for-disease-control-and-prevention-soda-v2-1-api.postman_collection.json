        {
          "id": "879a4e44-9ed4-421a-99be-d89152ba5ccd",
          "name": "Query a dataset (JSON)",
          "request": {
            "name": "Query a dataset (JSON)",
            "description": {
              "content": "Returns rows from a dataset as JSON. Supports SoQL via $select,\n$where, $order, $group, $limit, $offset, and $q parameters.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "resource",
                "{{dataset_id}}.json"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "$select",
                  "value": "<string>",
                  "description": "Columns to return (SoQL SELECT clause)."
                },
                {
                  "disabled": false,
                  "key": "$where",
                  "value": "<string>",
                  "description": "Row filter (SoQL WHERE clause)."
                },
                {
                  "disabled": false,
                  "key": "$order",
                  "value": "<string>",
                  "description": "Ordering (SoQL ORDER BY clause)."
                },
                {
                  "disabled": false,
                  "key": "$group",
                  "value": "<string>",
                  "description": "Grouping (SoQL GROUP BY clause)."
                },
                {
                  "disabled": false,
                  "key": "$having",
                  "value": "<string>",
                  "description": "Post-grouping filter (SoQL HAVING clause)."
                },
                {
                  "disabled": false,
                  "key": "$limit",
                  "value": "1000",
                  "description": "Maximum rows to return."
                },
                {
                  "disabled": false,
                  "key": "$offset",
                  "value": "0",
                  "description": "Row offset for pagination."
                },
                {
                  "disabled": false,
                  "key": "$q",
                  "value": "<string>",
                  "description": "Full-text search across the dataset."
                },
                {
                  "disabled": false,
                  "key": "$query",
                  "value": "<string>",
                  "description": "Full SoQL query, overriding individual $select/$where/etc."
                },
                {
                  "disabled": false,
                  "key": "$$app_token",
                  "value": "<string>",
                  "description": "Socrata application token (alternative to X-App-Token header)."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
